# Copy to .env.local and fill from Vercel. Never commit values.

# Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js
AUTH_SECRET=
AUTH_URL=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Pinned YYYYMM sent as LinkedIn-Version on every call. Not computed from today.
LINKEDIN_API_VERSION=202606
# 32-byte base64 key for encrypting access tokens at rest
TOKEN_ENCRYPTION_KEY=

# Day 1 de-risking routes only. Deleted once Auth.js owns the flow.
LINKEDIN_DEBUG_SECRET=
# Set only if the registered redirect URI is not this deployment's own host
LINKEDIN_DEBUG_REDIRECT_URI=

# Generation
# Text goes direct to Anthropic: structured output and adaptive thinking are
# first party features an OpenAI-compatible gateway does not carry.
ANTHROPIC_API_KEY=
# Images go through OpenRouter, which reports what each call cost.
OPENROUTER_API_KEY=
# Vercel Blob. A store connected to the project injects BLOB_STORE_ID and mints
# VERCEL_OIDC_TOKEN per deployment, and the SDK uses both. Set neither by hand.
# BLOB_READ_WRITE_TOKEN is the older static alternative and is not needed.

# Money
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_AGENCY=

# Email
LOOPS_API_KEY=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Cron
CRON_SECRET=

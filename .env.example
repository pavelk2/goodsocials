# Copy to .env.local and fill from Vercel. Never commit values.

# Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js
AUTH_SECRET=
AUTH_URL=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Pinned YYYYMM sent as LinkedIn-Version on every call. Not computed from today.
LINKEDIN_API_VERSION=202606
# 32-byte base64 key for encrypting access tokens at rest
TOKEN_ENCRYPTION_KEY=

# Day 1 de-risking routes only. Deleted once Auth.js owns the flow.
LINKEDIN_DEBUG_SECRET=
# Set only if the registered redirect URI is not this deployment's own host
LINKEDIN_DEBUG_REDIRECT_URI=

# Generation
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Money
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_AGENCY=

# Email
LOOPS_API_KEY=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Cron
CRON_SECRET=
